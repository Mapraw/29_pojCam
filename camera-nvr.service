[Unit]
Description=Raspberry Pi RTSP Camera NVR & Stream Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/camera_server
ExecStart=/usr/bin/python3 app.py --no-browser
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
